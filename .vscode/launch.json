{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch React app in Chrome",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "console": "integratedTerminal",
            "env": {
                "NO_COLOR": "1"
            },
            "serverReadyAction": {
                "pattern": "Local:.*127\\.0\\.0\\.1:([0-9]+)",
                "uriFormat": "http://127.0.0.1:%s",
                "action": "debugWithChrome",
                "webRoot": "${workspaceFolder}"
            }
        }
    ]
}
